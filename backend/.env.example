# ============================================================
# DataMart API Configuration
# ============================================================
DATAMART_API_KEY=your-datamart-api-key-here
DATAMART_BASE_URL=https://api.datamartgh.shop/api/developer

# ============================================================
# Paystack Configuration
# ============================================================
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret-here

# ============================================================
# Resend Email Configuration
# ============================================================
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=noreply@brokeflexdata.com
ADMIN_EMAIL=admin@brokeflexdata.com

# ============================================================
# MySQL Database Configuration (Required - Railway)
# ============================================================
DATABASE_URL=mysql://user:password@host:3306/database

# ============================================================
# Application Configuration
# ============================================================
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.com

# ============================================================
# Admin Authentication (JWT-based, bcrypt-hashed passwords)
# ============================================================
ADMIN_PASSWORD=change-this-password
JWT_SECRET=your-secure-random-jwt-secret-here
