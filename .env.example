# ============================================================
# Production Environment Variable Checklist
# ============================================================
# Copy this file to backend/.env and frontend/.env, then fill in your values.
# NEVER commit real secrets to version control.
# ============================================================

# ============================================================
# Backend Environment (backend/.env)
# ============================================================

# MySQL Database Configuration (Required - from Railway)
DATABASE_URL=mysql://user:password@host:port/database

# DataMart API Configuration
DATAMART_API_KEY=your-datamart-api-key-here
DATAMART_BASE_URL=https://api.datamartgh.shop/api/developer

# Paystack Configuration
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret-here

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=support@brokeflexdata.com
ADMIN_EMAIL=admin@brokeflexdata.com

# Application Configuration
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://brokeflexdata-frontend.onrender.com

# Admin Authentication
ADMIN_PASSWORD=change-this-password
JWT_SECRET=your-secure-random-jwt-secret-here

# ============================================================
# Frontend Environment (frontend/.env)
# ============================================================

# API Base URL (points to backend service)
VITE_API_BASE_URL=https://brokeflexdata-backend.onrender.com/api
